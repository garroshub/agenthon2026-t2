{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3-HS Runtime Repair House Scenario Graph",
  "type": "object",
  "required": [
    "schema_version",
    "abstain",
    "reason",
    "facts",
    "assumptions",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "v3-hs-s1.1-runtime-repair"
    },
    "abstain": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "doc_id",
          "quote",
          "claim"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "mechanism",
          "conditions",
          "counterexample",
          "fact_refs"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 2
    }
  }
}
